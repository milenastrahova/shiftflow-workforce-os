{
  "name": "shiftflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Workforce scheduling and operations dashboard — portfolio-ready React + TypeScript application",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.7",
    "@fontsource/manrope": "^5.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "engines": { "node": ">=22.12.0" }
}
